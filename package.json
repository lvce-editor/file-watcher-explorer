{
  "name": "@lvce-editor/file-watcher-explorer-monorepo",
  "version": "0.0.0-dev",
  "private": true,
  "description": "Inspect file watcher usage across LVCE Editor processes",
  "type": "module",
  "workspaces": [
    "packages/build",
    "packages/file-watcher-explorer",
    "packages/file-watcher-view"
  ],
  "scripts": {
    "build": "node packages/build/src/build.ts",
    "build:watch": "npm run build:watch --workspace=build",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "type-check": "tsc -b"
  },
  "keywords": [
    "Lvce Editor",
    "inotify",
    "file watchers"
  ],
  "author": "Lvce Editor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lvce-editor/file-watcher-explorer.git"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.4.0",
    "@types/node": "^26.1.0",
    "eslint": "^10.8.1",
    "knip": "^6.29.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
